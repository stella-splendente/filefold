---
import "@filekit/ui/styles.css";
import "../styles/site.css";
import { t, type Locale } from "@filekit/ui";
import { homePath } from "../lib/routes";
import Mark from "../components/Mark.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  alternates?: { locale: Locale; path: string }[];
  jsonLd?: Record<string, unknown>;
}
const { locale, title, description, alternates = [], jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = alternates.find((a) => a.locale !== locale);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale} href={new URL(a.path, Astro.site)} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/icon-pdf.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,400..600,30;1,9..144,400,30&family=Inter:wght@400;600&display=swap" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="ff">
    <div class="site">
      <header class="wrap site-header">
        <a class="brand" href={homePath(locale)}><Mark /> {t(locale, "brand")}</a>
        <nav class="site-nav" aria-label="Main navigation">
          {other && <a href={other.path} lang={other.locale}>{other.locale === "ko" ? "한국어" : "English"}</a>}
          <a class="pro" href={locale === "en" ? "/license/" : "/ko/license/"}>Pro</a>
        </nav>
      </header>
      <main class="wrap"><slot /></main>
      <footer class="wrap site-footer">
        <span>{t(locale, "brand")} · {t(locale, "tagline")}</span>
        <nav aria-label="Footer">
          <a href={locale === "en" ? "/privacy/" : "/ko/privacy/"}>Privacy</a>
          <a href={locale === "en" ? "/license/" : "/ko/license/"}>{t(locale, "license.title")}</a>
          <a href="https://github.com/stella-splendente/filefold/issues" rel="noopener">Support</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
