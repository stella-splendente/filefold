---
import { t, toolsBySuite, type Locale, type ToolDefinition } from "@filekit/ui";
import Base from "../layouts/Base.astro";
import ToolIsland from "./ToolIsland";
import { toolPath } from "../lib/routes";
import { toolDescription, toolJsonLd, toolTitle } from "../lib/seo";
import { POLAR_BENEFITS, POLAR_ORG_ID, checkoutUrl, storeUrl } from "../lib/env";

interface Props { locale: Locale; tool: ToolDefinition }
const { locale, tool } = Astro.props;
const ko = locale === "ko";
const alternates = (["en", "ko"] as Locale[]).map((l) => ({ locale: l, path: toolPath(l, tool.id) }));
const url = new URL(toolPath(locale, tool.id), Astro.site).toString();
const others = toolsBySuite(tool.suite).filter((x) => x.id !== tool.id);
const stores = (["chrome", "edge", "firefox"] as const).map((b) => ({ b, url: storeUrl(b, tool.suite) })).filter((s) => s.url);
const checkout = checkoutUrl(tool.suite);
const suiteColor = { pdf: "oklch(62% 0.17 25)", image: "oklch(60% 0.15 250)", audio: "oklch(58% 0.16 300)" }[tool.suite];
const storeName = { chrome: "Chrome", edge: "Edge", firefox: "Firefox" } as const;
---
<Base locale={locale} title={toolTitle(locale, tool)} description={toolDescription(locale, tool)} alternates={alternates} jsonLd={toolJsonLd(locale, tool, url)}>
  <header class="tool-hero" style={`--suite-color:${suiteColor}`}>
    <span class="pill"><i></i>{t(locale, `suites.${tool.suite}.name`)}</span>
    <h1 class="display">{t(locale, `tools.${tool.id}.name`)}</h1>
    <p class="lede">{t(locale, `tools.${tool.id}.description`)}</p>
  </header>

  <div class="panel">
    <ToolIsland client:only="preact" locale={locale} toolId={tool.id} orgId={POLAR_ORG_ID} benefits={POLAR_BENEFITS} checkoutUrl={checkout} />
  </div>

  {stores.length > 0 && (
    <section class="section install" aria-labelledby="install-title">
      <div>
        <p class="eyebrow">{ko ? "확장 프로그램" : "Browser extension"}</p>
        <h2 id="install-title" class="display">{t(locale, "common.installExtension")}</h2>
      </div>
      <div class="stores">{stores.map((s) => <a class="btn btn-quiet" href={s.url} rel="noopener">{storeName[s.b]}</a>)}</div>
    </section>
  )}

  <section class="section faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="display">FAQ</h2>
    {[1, 2, 3].map((n) => (
      <details><summary>{t(locale, `faq.q${n}`)}</summary><p>{t(locale, `faq.a${n}`)}</p></details>
    ))}
  </section>

  <section class="section" aria-labelledby="others-title" style={`--suite-color:${suiteColor}`}>
    <h2 id="others-title" class="display">{t(locale, "common.otherTools")}</h2>
    <ol class="tool-index">
      {others.map((x, i) => (
        <li>
          <a href={toolPath(locale, x.id)}>
            <span class="n">{String(i + 1).padStart(2, "0")}</span>
            <span class="t">{t(locale, `tools.${x.id}.name`)}<span class="d">{t(locale, `tools.${x.id}.description`)}</span></span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>
